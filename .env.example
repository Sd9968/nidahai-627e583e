# ── AWS (Mumbai ap-south-1) — fill after AWS setup ───────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RECORDINGS_BUCKET=nidahai-recordings-dev-YOUR_ACCOUNT_ID
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
USE_BEDROCK=true

# AWS Polly (English TTS)
POLLY_VOICE_EN=Joanna
POLLY_VOICE_AR=Hala
POLLY_ENGINE=neural

# ── Supabase (Mumbai) ────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Voice AI ─────────────────────────────────────────────────────
# STT: AWS Transcribe (default EN for consent/"yes"); sticky switch to AR
MUNSIT_API_KEY=
MUNSIT_VOICE_ID=ar-hijazi-female-2
MUNSIT_STT_ENDPOINTING_MS=800
MUNSIT_STT_HOTWORDS=موعد,عيادة,حجز,إلغاء,طبيب
STT_DEFAULT_LANG=en
STT_AR_PROVIDER=transcribe

# Latency (Twilio phone cannot hit true <300ms with Sonnet+Polly+ngrok)
LATENCY_MODE=fast
GREETING_LANG=en
VAD_STOP_SECS=0.15
VAD_START_SECS=0.1
LLM_MAX_TOKENS=256
# Use Haiku for voice TTFB; Sonnet is too slow for turn-taking
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: TTS_AR_PROVIDER=polly  # faster than Munsit for AR on phone

# Optional: Anthropic direct API if USE_BEDROCK=false
ANTHROPIC_API_KEY=

# ── Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Start Twilio dual-channel recording and upload to S3 for the CRM
TWILIO_RECORD_CALLS=true

# ── App ──────────────────────────────────────────────────────────
PRODUCT_NAME=NidahAI
CLINIC_ID=
AFTER_HOURS_ONLY=true

# Dashboard (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same AWS keys as bot — required for signed recording playback in /calls/[id]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_RECORDINGS_BUCKET=nidahai-recordings-dev-YOUR_ACCOUNT_ID

# ── WhatsApp confirmations (Twilio) ──────────────────────────────
# Twilio WhatsApp sandbox sender (default). Use your approved sender in prod.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_CONFIRMATIONS=true

# ── Clinic identity (spoken by the bot — must match the clinics row in Supabase)
CLINIC_NAME_EN=NidahAI Pilot Clinic
CLINIC_NAME_AR=عيادة نداه التجريبية
