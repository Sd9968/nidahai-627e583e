# Website configuration only. Keep clinic credentials in clinic/.env.
# Keep the existing Lovable project's values for these website integrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Website server-only Twilio credentials (never use a VITE_ prefix).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
PIPECAT_STREAM_URL=wss://your-voice-host.example/ws

# Optional fallback routing instead of PIPECAT_STREAM_URL.
TWILIO_AUTH_TOKEN=
TWILIO_AGENT_NUMBER=+16206708352
TWILIO_VOICE_WEBHOOK_URL=

# Optional Book a Demo email delivery.
RESEND_API_KEY=
LOVABLE_API_KEY=
