# ── AWS (Mumbai ap-south-1) — fill after AWS setup ───────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RECORDINGS_BUCKET=nidahai-recordings-dev-YOUR_ACCOUNT_ID
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
USE_BEDROCK=true

# AWS Polly (English TTS)
POLLY_VOICE_EN=Joanna
POLLY_VOICE_AR=Hala
POLLY_ENGINE=neural

# ── Supabase (Mumbai) ────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Voice AI ─────────────────────────────────────────────────────
# STT: Munsit (Arabic) + AWS Transcribe (English) — no Deepgram
MUNSIT_API_KEY=
MUNSIT_VOICE_ID=ar-hijazi-female-2
MUNSIT_STT_ENDPOINTING_MS=800
MUNSIT_STT_HOTWORDS=موعد,عيادة,حجز,إلغاء,طبيب
STT_DEFAULT_LANG=en
# munsit | transcribe — Arabic STT provider when using dual-STT experiments
STT_AR_PROVIDER=transcribe
MUNSIT_STT_URL=wss://api.munsit.com/api/v1/listen

# Optional: Anthropic direct API if USE_BEDROCK=false
ANTHROPIC_API_KEY=

# ── Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── App ──────────────────────────────────────────────────────────
PRODUCT_NAME=NidahAI
CLINIC_ID=
AFTER_HOURS_ONLY=true

# Dashboard (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
